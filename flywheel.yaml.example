# AI Flywheel local configuration template
# Copy to `flywheel.yaml` (gitignored) to customize without modifying the repo.

server:
  host: "127.0.0.1"
  port: 8765
  data_dir: "./data"

profile:
  # Default bundled profile (replicable open-source defaults)
  default_dir: "./profile"
  # Optional personal override pack (e.g. from a private profile repo).
  # Keep personal absolute paths out of this public template; supply them in
  # the gitignored flywheel.yaml instead.
  # override_dir: "<absolute path to your private profile pack>"
  override_dir: null

# Optional local directories for read-only Skill/Agent probing & P04 approved improvements
capabilities:
  skills_dirs: []
  agents_dirs: []

# Pluggable session sources for P00 reconcile scan (in addition to MCP push)
sessions:
  scan_sources: []
  # Example:
  # - client: "codex"
  #   path: "~/.codex/sessions"
  #   glob: "**/*.jsonl"
  # - client: "claude-code"
  #   path: "~/.claude/projects"
  #   glob: "**/*.jsonl"

  # Codex strict-archive mode: only sessions that land in an archive directory
  # (or are declared explicitly through MCP `flywheel_session_intent` / the portal)
  # enter the distill queue. An active, unarchived Codex session is never queued;
  # a queued item whose archive file disappears is withdrawn on the next sync.
  # Example:
  # - client: "codex"
  #   path: "~/.codex/archived_sessions"
  #   glob: "**/*.jsonl"
  codex_archive_sources: []

  # Distill queue tuning:
  #   queue_max_item_chars - per-item character cap; a larger session is compacted
  #                          first and then split into ordered chunks 1/N..N/N so the
  #                          final conclusions at the tail are never truncated.
  #   queue_max_retries    - failed attempts before an item is isolated into
  #                          dead_letter instead of blocking later batches.
  #   codex_archive_sync_interval_seconds - interval of the lightweight archive
  #                          reconciliation loop that the `serve` role runs.
  #   scan_quiet_window_seconds - how long an Antigravity transcript must have gone
  #                          unchanged before a passive scan reads it. Antigravity
  #                          keeps no archive directory that marks a finished
  #                          conversation: a transcript still changing in place is
  #                          left out of the pass and picked up once it is quiet.
  #                          0 switches the window off; 900 is 15 minutes.
  queue_max_item_chars: 24000
  queue_max_retries: 3
  codex_archive_sync_interval_seconds: 60
  scan_quiet_window_seconds: 900

  # Session triage:
  #   exclude_content_prefixes - session content prefixes to exclude (e.g. headless batch scripts)
  #   controlled_write_markers - phrases that identify a controlled knowledge-base write dispatch
  #                          in your installation (a heading of its dispatch template, the name of
  #                          its writer skill). A session whose only instruction carries one is
  #                          `excluded (SUBAGENT_FRAGMENT)`: it is the writing of a document, not a
  #                          conversation to distill. Built in already: an approved write-set named
  #                          together with the write contract (postflight check, pre/postimage,
  #                          controlled-write wording) in a single-instruction brief.
  triage:
    exclude_content_prefixes: []
    controlled_write_markers: []

# Pluggable knowledge sink (decoupled from flywheel policies)
knowledge_sink:
  # "builtin_kb" writes to ./data/knowledge (zero config)
  # "local_markdown_wiki" mounts any local Markdown / Obsidian / Wiki folder
  type: "builtin_kb"
  root: "./data/knowledge"
  allowed_write_prefixes:
    - "lessons/"
    - "topics/"
    - "projects/"
  max_write_set: 8

  # P04 schema-aware Wiki gate (D4).  When the sink root contains
  # `.wiki-schema.md`, every write is validated against its live
  # core/content/partition contracts, then D2 postflight (alias lint +
  # index sync + core validator) runs.  Core files and raw/archive paths
  # are always blocked; private credential pages may only live under
  # `{project}/项目配置/`.
  #
  # Script paths are intentionally empty in this public template.  Supply
  # them in the gitignored flywheel.yaml (or via the FLYWHEEL_WIKI_* /
  # FLYWHEEL_POSTFLIGHT_HOOK_SCRIPT env vars).  With
  # `wiki_gate_require_scripts: true`, a schema-governed write fails closed
  # when the postflight hook is not configured.
  wiki_gate_enabled: true
  wiki_gate_require_scripts: true
  # Schema write gate (SchemaWriteGate): after a document is written, this hook
  # runs the mounted contract's own index/validator sync.  It applies to any
  # schema-governed root, not only a Wiki.  With `wiki_gate_require_scripts:
  # true`, a write fails closed when the hook is not configured.
  postflight_hook_script: ""     # or FLYWHEEL_POSTFLIGHT_HOOK_SCRIPT
  # Legacy name of the same hook.  Fully supported: existing configurations and
  # FLYWHEEL_WIKI_D2_POSTFLIGHT keep working, and it is used whenever
  # `postflight_hook_script` is empty.  When both are set, the neutral name wins.
  wiki_d2_postflight_script: ""
  wiki_lint_script: ""
  wiki_python: ""          # default: the flywheel process interpreter
  wiki_bash: "bash"
  wiki_gate_timeout_seconds: 300
  wiki_gate_evidence_dir: ""   # default: <data_dir>/wiki-gate
  # Name of the environment variable the D2 script reads as its work root.
  # Empty means the neutral default (FLYWHEEL_WORK_ROOT); set the name your
  # script expects here (or via FLYWHEEL_D2_WORK_ROOT_ENV).
  wiki_d2_work_root_env: ""

  # Catch-all project for knowledge documents routed on EVIDENCE, i.e. plans of the zero-config
  # dry_run planner. api / cli plans declare their route in the P03 plan (page type + project chosen
  # from the candidates read off the mounted Wiki) and are never redirected here: a note declared
  # unattributed, or whose declaration the evidence contradicts, is not written and is recorded in a
  # `planned_doc_unrouted` audit event. Set a project directory name (a folder with 实战笔记/ under
  # the projects partition) to catch the evidence-routed cards instead.
  practice_fallback_project: ""

  # Opt-in audit trail for P04 (default off). When true, the files a batch just wrote
  # and verified are committed to the local Git repository they live in — one commit
  # per repository, staging ONLY those written paths (`git add -- <paths>`); unrelated
  # modified or untracked files in the same working tree are never touched, and nothing
  # is ever pushed. A path outside a Git repository, a missing git binary or a failing
  # commit is recorded as an audit event (`p04_git_commit_skipped` /
  # `p04_git_commit_failed`) and never fails the batch. The knowledge root must be
  # inside a repository and not git-ignored for commits to land.
  auto_git_commit: false

# Autonomous workflow P00-P07 execution engine
workflow:
  schedule_enabled: false
  daily_cron: "0 20 * * *"
  weekly_exception_cron: "0 20 * * 5"
  # Approval gate after P03: smart | always | auto
  #   smart  - pause only for Skill changes, flagged/deleting/overwriting writes,
  #            or batches above high_write_count_threshold
  #   always - pause whenever there is anything to write
  #   auto   - never pause (requires both auto_approve_writes valves)
  approval_mode: "smart"
  high_write_count_threshold: 6
  # Per-batch caps on the write items of one plan.
  #   max_writes_per_run        - every item that is not a project-domain page: the main
  #                               experience card, a rule, a Skill, an incident card.
  #   max_domain_writes_per_run - project-domain increment pages (the table /
  #                               configuration / architecture / algorithm pages the
  #                               mounted Wiki's deposit_routing names). They are counted
  #                               apart, so an investigation of several tables cannot
  #                               crowd the experience card or a rule out of the plan.
  #                               0 plans no domain page.
  #   Whichever is smaller, a cap or `knowledge_sink.max_write_set`, is the one that
  #   applies, and a batch never exceeds `knowledge_sink.max_write_set` physical
  #   paths in all. `high_write_count_threshold` counts the final items of the plan.
  max_writes_per_run: 8
  max_domain_writes_per_run: 8
  # Default safe mode: pause after P03 for Diff/rule preview approval in Web UI
  auto_approve_writes: false
  max_sessions_per_run: 10
  max_chars_per_run: 180000
  # How late (seconds) the daily_flywheel job may still run after its fire time. A host that
  # slept or was busy past the cron time resumes the batch on wake-up instead of losing it.
  # The same value bounds the window in which a missed fire is caught up (see the next key).
  # Minimum 60; 14400 is four hours.
  misfire_grace_seconds: 14400
  # Serve role only. When today's scheduled fire was missed (the service was not running at
  # the cron time), the grace window is still open and there is work queued, the recovery
  # loop records a `schedule_misfire_detected` audit event (at most once a day) and starts
  # one catch-up batch (trigger="scheduled"). `false` records the miss and leaves
  # `scheduler.missed_today = true` in GET /api/site/automations, but never starts a batch.
  catchup_missed_schedule: true

# Background AI execution runner for P02/P03/P04
runner:
  # "dry_run" (zero cost heuristic) | "api" (OpenAI-compatible HTTP / local gateway) | "cli" (local CLI subprocess)
  mode: "dry_run"
  api:
    base_url: ""
    api_key: ""
    model: ""
    # Wall-clock limit of one model call, in seconds. 240 is the code default.
    timeout_seconds: 240
    # Reasoning effort sent to an OpenAI-compatible endpoint ("low" | "medium" | "high").
    # Empty (the default) omits the parameter from the request, which keeps the runner
    # portable to endpoints that do not know it. A non-empty value enters the cache key,
    # so switching it never reuses a reply produced with another effort.
    reasoning_effort: ""
    # How many times a timed-out or refused connection is retried at once, without backoff.
    # 0 disables the retry; 1 means one extra attempt after the first one.
    transport_retries: 1
    # How much of one session's text the P02 review prompt carries, in characters
    # (2000..64000). A session within the budget is carried whole, so a root cause
    # in the middle of a long investigation reaches the reviewer; a longer one keeps
    # its head and its tail around one explicit omission marker.
    p02_session_char_limit: 16000
    # Per-stage model layering. A stage uses its own model and reasoning effort when
    # they are set and `model` / `reasoning_effort` otherwise. The pair a stage really
    # runs with is part of the api_cache key, so moving a stage to another model
    # never reuses the reply the old one produced.
    review_model: ""
    review_reasoning_effort: ""
    plan_model: ""
    plan_reasoning_effort: ""
  cli:
    # Example for local Codex / Claude CLI:
    # command: "claude"
    # args: ["-p", "{prompt}", "--output-format", "json"]
    command: ""
    args: []
    timeout_seconds: 180
    working_dir: null

# Delivery adapters after P06 report
delivery:
  local_portal: true
  git_closure:
    enabled: false
    remote: "origin"
    branch: "main"
  webhook:
    enabled: false
    url: ""
    # Optional HMAC-SHA256 signing key. When non-empty, every request carries
    # X-Flywheel-Signature: sha256=<hex> over the raw UTF-8 JSON body. Keep the
    # value out of this file if it is shared: FLYWHEEL_WEBHOOK_SECRET overrides it.
    secret: ""
    timeout_seconds: 10
    # Routine "fyi" notices are opt-in; approval and failure notices are not.
    notify_on_fyi: false
  # Feishu via local lark-cli (bot identity). All ids are open ids (ou_...);
  # keep personal values in the gitignored flywheel.yaml.
  feishu_cli:
    enabled: false
    command: "lark-cli"
    identity: "bot"
    # Private-chat recipient (open id). Interactive cards require it.
    user_id: ""
    notify_on_fyi: false
    # Interactive approval cards (needs lark-cli >= 1.0.64, the Feishu app must
    # subscribe to card callbacks, and `flywheel feishu-check` must pass).
    # command / command_args / identity changes require a restart.
    interactive: false
    approver_open_ids: []

# Explicit safety valves (inspired by AIHOT): control external actions without changing state machine logic
safety_valves:
  workflow_enabled: true
  # Gates every runner that calls a model or a local CLI.
  # `model_execution_enabled` is the truthful name; leave it unset to let
  # `cli_execution_enabled` (the older name) decide.
  model_execution_enabled: null
  cli_execution_enabled: true
  # The last word on auto-approval: while this is false, `workflow.approval_mode:
  # auto` runs as `smart` instead of approving on its own.
  auto_approve_writes: false
  git_closure_enabled: false
  public_export_strip_paths: true
